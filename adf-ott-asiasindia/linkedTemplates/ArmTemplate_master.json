{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ott-asiasindia"
		},
		"ls_SqlServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-ott.database.windows.net"
		},
		"ls_SqlServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-ott-sqldb"
		},
		"ls_SqlServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stottasiasindia.dfs.core.windows.net"
		},
		"ls_filesys_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "\\\\LAPTOP-M16F1HCB\\Host"
		},
		"ls_filesys_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "hoble"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-ott-sindia01.vault.azure.net/"
		},
		"ls_synapse_properties_typeProperties_endpoint": {
			"type": "string",
			"defaultValue": "https://sy-ott-workspace.dev.azuresynapse.net"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ott-asiasindia_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_synapse_properties_typeProperties_endpoint": {
						"value": "[parameters('ls_synapse_properties_typeProperties_endpoint')]"
					},
					"ls_SqlServer_properties_typeProperties_server": {
						"value": "[parameters('ls_SqlServer_properties_typeProperties_server')]"
					},
					"ls_SqlServer_properties_typeProperties_database": {
						"value": "[parameters('ls_SqlServer_properties_typeProperties_database')]"
					},
					"ls_SqlServer_properties_typeProperties_userName": {
						"value": "[parameters('ls_SqlServer_properties_typeProperties_userName')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_filesys_properties_typeProperties_host": {
						"value": "[parameters('ls_filesys_properties_typeProperties_host')]"
					},
					"ls_filesys_properties_typeProperties_userId": {
						"value": "[parameters('ls_filesys_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}